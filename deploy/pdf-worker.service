[Unit]
Description=Crecer y Ser PDF generator
After=network.target pocketbase.service

[Service]
Type=simple
User=cys-pdf
Group=cys-pdf
WorkingDirectory=/opt/cys-pdf/current
EnvironmentFile=/etc/cys-pdf.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/cys-pdf/browsers
Environment=HOME=/var/lib/cys-pdf
ExecStart=/opt/cys-node/bin/node scripts/pdf-worker.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cys-pdf
MemoryMax=900M
TasksMax=256
UMask=0077

[Install]
WantedBy=multi-user.target
